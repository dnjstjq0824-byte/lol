# ==============================================================================
# BN RiftStats Environment Configuration
# Target: https://op.gg/ (100% Core LoL Functional Parity)
# Patch: 16.21 (Data Dragon: 16.21.1)
# ==============================================================================

# Server Network Configuration
PORT=8080
ENV=development

# Riot Games Developer API Configuration
# Paste your personal Developer API Key (starts with RGAPI-) or leave blank to run in authentic 16.21 fixture simulation mode.
RIOT_API_KEY=

# Riot API Rate Governor Mode
# DEV_PROTOTYPE_MODE : 20 requests / 1 sec, 100 requests / 2 min
# PRODUCTION_MODE    : 500 requests / 10 sec, 30,000 requests / 10 min
GOVERNOR_MODE=DEV_PROTOTYPE_MODE

# Database & Cache Infrastructure
DATABASE_URL=postgres://riftstats:riftstats_secret@localhost:5432/riftstats?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Search & Logging (Optional)
OPENSEARCH_URL=http://localhost:9200

# Security & JWT Token Signing (CHANGE in production, min 32 chars)
JWT_SECRET=riftstats-super-secure-production-jwt-signing-secret-2026

# CORS: comma-separated allowed origins for cross-origin deployments.
# Empty = same-origin only (recommended; the Go server hosts the SPA itself).
CORS_ALLOWED_ORIGINS=

# Seed admin account. ADMIN_PASSWORD is REQUIRED in production; when it is
# empty outside production the dev default "securepassword" is used, and in
# production a random one-time password is generated and printed once at boot.
ADMIN_EMAIL=admin@riftstats.bn.io
ADMIN_PASSWORD=

# Google OAuth2 social login (all three required to enable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# Aggregator cycle length in minutes (default 60).
AGGREGATE_INTERVAL_MIN=60

# Sentry error tracking DSN (empty = disabled).
SENTRY_DSN=
